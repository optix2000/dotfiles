#!/bin/sh
set -eu

{{- if eq .chezmoi.os "darwin" }}
if [ -w /usr/local/bin/safe-agent ] || [ -w /usr/local/bin ]; then
  install -m 755 "$HOME/.config/sandbox/safe-agent" /usr/local/bin/safe-agent
else
  printf '%s\n' 'safe-agent: /usr/local/bin/safe-agent is not writable; use the safe-agent shell function or install it with sudo.' >&2
fi
{{- else }}
exit 0
{{- end }}
