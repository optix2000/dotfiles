{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "share": "disabled",
  "plugin": ["opencode-plugin-manager"],
  "permission": {
    "github_*": "deny",
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "sleep *": "allow",
      "grep *": "allow",
      "ls *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "rg *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "diff *": "allow",
      "tar -xOf *": "allow",
      "tar xOf *": "allow",
      "tar -tzf *": "allow",
      "tar tzf *": "allow",
      "tar -tf *": "allow",
      "tar tf *": "allow",
      "git status *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git diff *": "allow",
      "git remote": "allow",
      "git remote -v": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "gh issue view *": "allow",
      "gh issue list *": "allow",
      "gofmt *": "allow",
      "docker build *": "allow",
      "helm template *": "allow",
      "helm lint *": "allow",
      "echo *": "allow"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": false
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": false
    }
  },
  "agent": {
    "plan-reviewer": {
      "description": "Reviews coding and code design plans",
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "include": ["reasoning.encrypted_content"],
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "coder": {
      "description": "Expert coder that can handle complex coding. Use for parallelizing independent coding tasks.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "include": ["reasoning.encrypted_content"]
    },
    "deep-plan": {
      "description": "Planning agent that validates plans with plan-reviewer",
      "mode": "primary",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    }
  }
}
