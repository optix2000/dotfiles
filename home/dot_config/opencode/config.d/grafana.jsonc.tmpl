{{- /* Empty output removes this exact managed fragment in the base profile.
     Ignoring it instead would leave an earlier work configuration installed. */ -}}
{{- if eq (includeTemplate "profile" .) "work" -}}
{
  "mcp": {
    "servers": {
      "grafana": {
        "type": "local",
        "command": ["uvx", "mcp-grafana"],
        "disabled": true,
        "environment": {
          "GRAFANA_URL": "{env:GRAFANA_URL}",
          "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_SERVICE_ACCOUNT_TOKEN}"
        }
      }
    }
  }
}
{{ end -}}
