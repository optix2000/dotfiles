{{- /* Keep machine-local plugin entries outside the managed source state. */ -}}
{{- $localPluginsPath := joinPath .chezmoi.destDir ".config/opencode/plugins.local.json" -}}
{{- $localPlugins := list -}}
{{- if stat $localPluginsPath -}}
{{- $localConfig := include $localPluginsPath | fromJson -}}
{{- if not (kindIs "slice" $localConfig.plugins) -}}
{{- fail "plugins.local.json must contain a plugins array" -}}
{{- end -}}
{{- $localPlugins = $localConfig.plugins -}}
{{- end -}}
{
  "$schema": "https://raw.githubusercontent.com/optix2000/opencode-plugin-manager/main/plugins.schema.json",
  "autoinstall": true,
  "reportPlugins": true,
  "plugins": [
    {
      "source": "npm",
      "name": "@vectorize-io/opencode-hindsight",
      "options": {
        "hindsightApiUrl": "http://localhost:8888",
        "recallBudget": "high"
      }
    },
    {
      "source": "git",
      "repo": "https://github.com/optix2000/opencode-ast.git"
    },
    {
      "source": "git",
      "repo": "https://github.com/optix2000/opencode-config-d.git"
    },
    {
      "source": "git",
      "repo": "https://github.com/optix2000/opencode-provider-system-prompts.git"
    },
    {
      "source": "git",
      "repo": "https://github.com/optix2000/opencode-agent-instructions.git"
    }{{ range $localPlugins }},
{{ . | toPrettyJson | trim | indent 4 }}{{ end }}
  ]
}
