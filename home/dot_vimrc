" ---------------
" Lightline configs
" ---------------
let g:lightline = {}

function! LightlineDiagnosticCount(severity) abort
  if !has('nvim')
    return 0
  endif
  return luaeval("#vim.diagnostic.get(0, { severity = vim.diagnostic.severity[_A] })", a:severity)
endfunction

function! LightlineDiagnosticWarnings() abort
  let l:count = LightlineDiagnosticCount('WARN')
  return l:count > 0 ? printf('W:%d', l:count) : ''
endfunction

function! LightlineDiagnosticErrors() abort
  let l:count = LightlineDiagnosticCount('ERROR')
  return l:count > 0 ? printf('E:%d', l:count) : ''
endfunction

function! LightlineDiagnosticOk() abort
  return LightlineDiagnosticCount('ERROR') + LightlineDiagnosticCount('WARN') == 0 ? 'OK' : ''
endfunction

let g:lightline.component_expand = {
      \  'diagnostic_warnings': 'LightlineDiagnosticWarnings',
      \  'diagnostic_errors': 'LightlineDiagnosticErrors',
      \  'diagnostic_ok': 'LightlineDiagnosticOk',
      \ }
let g:lightline.component_type = {
      \     'diagnostic_warnings': 'warning',
      \     'diagnostic_errors': 'error',
      \     'diagnostic_ok': 'left',
      \ }

" Lightline
let g:lightline.active = { 'right':[[ 'diagnostic_errors', 'diagnostic_warnings', 'diagnostic_ok'], ['lineinfo'], ['percent'], ['fileformat', 'fileencoding', 'filetype']] }

