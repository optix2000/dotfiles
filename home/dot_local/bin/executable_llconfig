#!/bin/sh
set -eu

if [ "$(uname -s)" != "Linux" ]; then
  printf '%s\n' 'llconfig: unsupported operating system' >&2
  exit 69
fi

case "$(uname -m)" in
  x86_64|amd64)
    binary="$HOME/.local/libexec/llconfig/llconfig-linux-amd64"
    ;;
  aarch64|arm64)
    binary="$HOME/.local/libexec/llconfig/llconfig-linux-arm64"
    ;;
  *)
    printf 'llconfig: unsupported architecture: %s\n' "$(uname -m)" >&2
    exit 69
    ;;
esac

if [ ! -x "$binary" ]; then
  printf 'llconfig: managed binary is not executable: %s\n' "$binary" >&2
  exit 69
fi

exec "$binary" "$@"
