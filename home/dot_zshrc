if [[ -r "$HOME/.zsh/zsh-snap/znap.zsh" ]]; then
  source "$HOME/.zsh/zsh-snap/znap.zsh"
else
  print -u2 'zsh-snap is not installed; run chezmoi apply --refresh-externals.'
  return 0
fi

# Install base zshrc
znap clone grml/grml-etc-core
source ~/.zsh/grml/grml-etc-core/etc/zsh/zshrc

# Set homebrew path
if [[ "$OSTYPE" == "darwin"* ]]; then
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi

  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
  esac

  export SAFE_AGENT_PROFILE="$HOME/.config/sandbox/agent-base.sb"

  safe-opencode() {
    SAFE_OPENCODE_ALLOW_ALL="${SAFE_OPENCODE_ALLOW_ALL:-1}" safe-agent opencode "$@"
  }

  safe-opencode-docker() {
    SAFE_OPENCODE_ALLOW_ALL="${SAFE_OPENCODE_ALLOW_ALL:-1}" safe-agent --enable=docker opencode "$@"
  }
fi

znap source ohmyzsh/ohmyzsh plugins/terraform
znap source ohmyzsh/ohmyzsh plugins/gem
znap source ohmyzsh/ohmyzsh plugins/golang
znap source ohmyzsh/ohmyzsh plugins/gnu-utils
znap source ohmyzsh/ohmyzsh plugins/helm
znap source ohmyzsh/ohmyzsh plugins/docker

if command -v kubectl &>/dev/null; then
  znap fpath _kubectl 'kubectl completion zsh'
fi
